# CareerOS environment

# Supabase Postgres (Project Settings → Database)
# Use the Transaction pooler URI for DATABASE_URL (port 6543, ?pgbouncer=true)
# Use the Direct connection URI for DIRECT_URL (port 5432) — required for Prisma migrate/push
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Auth bypass for local-only without login (set false on Vercel)
DEV_BYPASS_AUTH="true"
NEXT_PUBLIC_DEV_BYPASS_AUTH="true"

# Case-study screenshot capture (local only). Uses isolated demo user — never overwrite real inventory.
# Run: npm run seed:case-study
# Set false (or unset) for normal personal use / production.
CAREEROS_CASE_STUDY_MODE="false"

# Comma-separated allowlist for magic-link sign-in
ALLOWED_EMAILS="roshan@theonlyrosh.com,theonlyroshn@gmail.com"

# Google AI (Gemini) — optional CV polish + LLM-judge fallback
GEMINI_API_KEY=
GEMINI_SCORE_MODEL="gemini-2.0-flash"
# Force built-in CV writer (skip Gemini for resumes). Default on.
RESUME_DETERMINISTIC_ONLY="true"

# Resume Engine: v3 = canonical inventory composer; v2 = legacy reference-templates
RESUME_ENGINE_VERSION="v4"
# Optional theme override: arthur-cox | minimal-ats
# RESUME_THEME_ID="arthur-cox"
# RESUME_CRITIC_DISABLED="true"
# RESUME_CRITIC_AUTO_IMPROVE="false"

# LLM job-fit judge (primary). Free tier: https://console.groq.com
# Default openai/gpt-oss-20b (replaces deprecated llama-3.1-8b-instant, shutdown 2026-08-16).
# Stronger: openai/gpt-oss-120b or qwen/qwen3.6-27b (replaces llama-3.3-70b-versatile).
GROQ_API_KEY=
GROQ_SCORE_MODEL="openai/gpt-oss-20b"
# SCORE_LLM_DISABLED="true"  # force keyword heuristics only

# Job aggregators (optional — expands discovery beyond Greenhouse/Lever/Ashby)
# Free tier: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Board presence verify via search index (optional — does NOT scrape LinkedIn/Glassdoor)
# Brave: https://brave.com/search/api/  OR SerpAPI: https://serpapi.com/
BRAVE_SEARCH_API_KEY=
SERPAPI_KEY=

# Supabase Auth (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
