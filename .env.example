# CareerOS environment

# Supabase Postgres (Project Settings → Database)
# Use the Transaction pooler URI for DATABASE_URL (port 6543, ?pgbouncer=true)
# Use the Direct connection URI for DIRECT_URL (port 5432) — required for Prisma migrate/push
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Auth bypass for local-only without login (set false on Vercel)
DEV_BYPASS_AUTH="true"
NEXT_PUBLIC_DEV_BYPASS_AUTH="true"

# Comma-separated allowlist for magic-link sign-in
ALLOWED_EMAILS="roshan@theonlyrosh.com,theonlyroshn@gmail.com"

# Google AI (Gemini)
GEMINI_API_KEY=

# Supabase Auth (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
